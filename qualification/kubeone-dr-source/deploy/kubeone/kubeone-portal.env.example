# Server-owned paths only. Do not put customer credentials or kubeconfig data here.
LAYERSENTRY_KUBEONE_WORKSPACE_ROOT=/var/lib/layersentry/kubeone
LAYERSENTRY_KUBEONE_REGISTRY_FILE=/etc/layersentry/kubeone-registry.json
LAYERSENTRY_KUBEONE_APPLICATION_CATALOG=/etc/layersentry/kubeone-applications.json
LAYERSENTRY_KUBEONE_BIN=/usr/local/bin/kubeone
LAYERSENTRY_KUBECTL_BIN=/usr/bin/kubectl
LAYERSENTRY_HELM_BIN=/usr/local/bin/helm
LAYERSENTRY_KUBEONE_PORTAL_LISTEN=127.0.0.1:9445

# Must match the protected LayerSentry gateway token used by FireEdge/control-plane proxy.
# Populate through the deployment secret mechanism; never commit a real token.
LAYERSENTRY_GATEWAY_TOKEN=REPLACE_AT_DEPLOY_TIME
# Alternatively use LAYERSENTRY_GATEWAY_TOKEN_FILE with a protected secret file,
# leaving LAYERSENTRY_GATEWAY_TOKEN unset (never configure both).
# Optional mTLS: configure ALL four, using absolute canonical paths and the
# approved gateway certificate SHA-256 digest(s), comma separated. No automatic
# trust enrollment or native ownership is performed. Private key is file-only.
# LAYERSENTRY_KUBEONE_PORTAL_TLS_CERT_FILE=/etc/layersentry/portal/server.pem
# LAYERSENTRY_KUBEONE_PORTAL_TLS_KEY_FILE=/etc/layersentry/portal/server.key
# LAYERSENTRY_KUBEONE_PORTAL_CLIENT_CA_FILE=/etc/layersentry/portal/client-ca.pem
# LAYERSENTRY_GATEWAY_CERTIFICATE_SHA256=APPROVED_GATEWAY_LEAF_SHA256


# Optional one-click etcd-to-NFS recovery (disabled until explicitly configured).
# Oneadmin-owned, mode 0600, protected JSON with approved NFS and DR identities.
# The mount, Restic binary, separately protected password file, private LOCAL
# staging directory, and exact systemd ReadWritePaths must exist before enable.
# LAYERSENTRY_KUBEONE_RECOVERY_CONFIG_FILE=/etc/layersentry/kubeone-recovery.json


# Optional official, checksum-verified KubeOne v1.14.4 release candidate.
# Keep installed v1.14.3 and every protected cluster unchanged by default.
# Requires independently installed and audited root-owned, non-group/world
# writable binary plus selected Kubernetes/CNI/CSI upgrade qualification.
# LAYERSENTRY_KUBEONE_BIN=/opt/layersentry/kubeone/v1.14.4/kubeone
# LAYERSENTRY_KUBEONE_RELEASE_PIN=1.14.4
# This is NOT automatic VM/cluster upgrading or automatic DC/DR promotion.

# Automatic KubeOne warm DR coordination is DISABLED by default.
# Only configure in the independently running DR-site portal after signed
# native fencing, cross-site storage, independent app+network verifier and
# DR-side high-availability coordinator election have been qualified.
# LAYERSENTRY_KUBEONE_AUTODR_ENABLE=false
# LAYERSENTRY_KUBEONE_AUTODR_CONTROLLER_SITE=dr-cluster
# See AUTO_DR_FAILOVER_FAILBACK_CODE_ONLY.md for strict source-only limitations.

# Installer mTLS readiness consumes a separately authorized client identity.
# No key or account is generated. Public trust files must have protected
# custody; the private key is a protected file readable by oneadmin.
# These settings are unnecessary for the default loopback HTTP profile.
# LAYERSENTRY_KUBEONE_PORTAL_READINESS_SERVER_CA_FILE=/etc/layersentry/portal/server-ca.pem
# LAYERSENTRY_KUBEONE_PORTAL_READINESS_SERVER_NAME=portal.example.invalid
# LAYERSENTRY_KUBEONE_PORTAL_READINESS_CLIENT_CERT_FILE=/etc/layersentry/portal/readiness-client.pem
# LAYERSENTRY_KUBEONE_PORTAL_READINESS_CLIENT_KEY_FILE=/etc/layersentry/portal/readiness-client.key
# See PORTAL_READINESS.md for the supported service profile and evidence limits.
